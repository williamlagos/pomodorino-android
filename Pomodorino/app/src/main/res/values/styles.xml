<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Styles -->
    <style name="TextAppearance.Material3.HeadlineLarge" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Material3.LabelLarge" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Material3.Button.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Material3.Button.IconButton.Filled.Tonal" parent="Widget.Material3.Button.IconButton">
        <item name="android:background">@drawable/bg_tonal_button</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>
</resources>
